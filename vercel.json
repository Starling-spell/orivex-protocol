{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/genlayer-studionet.json",
      "destination": "/genlayer-studio-next.json",
      "permanent": false
    },
    {
      "source": "/genlayer-examples.json",
      "destination": "/genlayer-next-examples.json",
      "permanent": false
    }
  ]
}
